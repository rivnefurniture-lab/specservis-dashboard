# Обов'язкові production-секрети. Генеруйте окремі випадкові значення:
#   openssl rand -base64 48
SESSION_SECRET=

# JSON-об'єкт із scrypt salt/hash для стандартних акаунтів. Зберігати тільки
# як encrypted/sensitive environment variable, ніколи не комітити значення.
DASHBOARD_ACCOUNT_CREDENTIALS=

# Окремий контур доступу до restricted boardroom. Не використовуйте тут логіни
# або секрети основного кабінету; пароль зберігається лише як scrypt hash.
CONFIDENTIAL_USERNAME=
CONFIDENTIAL_PASSWORD_SALT=
CONFIDENTIAL_PASSWORD_HASH=
CONFIDENTIAL_SESSION_SECRET=
CONFIDENTIAL_IMPORT_SECRET=
CRON_SECRET=

# Read-only облікові дані SmartTender для пошуку Prozorro.
SMARTTENDER_USERNAME=
SMARTTENDER_PASSWORD=

# Microsoft Entra application with read-only Microsoft Graph access.
# The app holds Sites.Selected on exactly one site — nothing else in SharePoint
# is reachable, and no code path writes anything back.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Окрема Entra application для опціональних вихідних інтеграцій. Не підставляйте
# сюди read-only credential вище. Потрібні application permissions Mail.Send та
# Sites.Selected із Write лише на виділений сайт/книгу експорту.
TENDER_INTEGRATION_TENANT_ID=
TENDER_INTEGRATION_CLIENT_ID=
TENDER_INTEGRATION_CLIENT_SECRET=
TENDER_NOTIFICATION_SENDER=
TENDER_NOTIFICATION_SUBSCRIPTIONS_JSON=[]
TENDER_EXCEL_SITE_ID=
TENDER_EXCEL_DRIVE_ID=
TENDER_EXCEL_ITEM_ID=
TENDER_EXCEL_WORKSHEET=Тендери
TENDER_EXCEL_TABLE=TenderExport

# Сайт і папка з трьома реєстрами.
SHAREPOINT_HOSTNAME=specservis.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/CRM_Dev
SHAREPOINT_FOLDER=Tenders/Excels

# Назви книг у цій папці.
SHAREPOINT_FILE_NAME=закупівлі.xlsx
SHAREPOINT_PIPELINE_FILE=ПЕРЕЛІК-BITRIX копия.xlsx
SHAREPOINT_DELIVERY_FILE=Реалізація проєктів 1111.xlsx

# Сховище зрізів ринку. Підставляється автоматично, коли до проєкту підключено
# Vercel Blob store. Без нього оновлення ринку нема куди записати.
BLOB_READ_WRITE_TOKEN=

# PostgreSQL/Neon для нормалізованої аналітики, серверних пресетів і платежів.
# Без DATABASE_URL сторінка працює на позначеному legacy snapshot, а пресети
# зберігаються лише в браузері конкретного користувача.
DATABASE_URL=

# Необов'язкове підтверджене збагачення оплатами spending.gov.ua під час імпорту.
# Значення probable зберігаються для аудиту, але ніколи не входять у суми.
ANALYTICS_SPENDING=false
ANALYTICS_SCOPE=monitoring
ANALYTICS_IMPORT_FILE=

# Автосинхронізація analytics v2: discovery та імпорт-черга запускаються
# незалежно кожні 5 хвилин, щоб довгий імпорт не блокував пошук нових тендерів.
ANALYTICS_HISTORY_FROM=2023-01-01
ANALYTICS_CHANGE_LOOKBACK_DAYS=7
ANALYTICS_FEED_PAGES=3
ANALYTICS_DETAIL_CONCURRENCY=4
ANALYTICS_DISCOVERY_DETAIL_CONCURRENCY=4
ANALYTICS_IMPORT_BATCH=100
ANALYTICS_QUEUE_BUDGET_MS=70000
ANALYTICS_SEARCH_CONCURRENCY=6
ANALYTICS_EXPANDED_DAYS_PER_RUN=1

# Кількість останніх днів, які переобходить планове оновлення (типово 3).
MARKET_REFRESH_DAYS=3

# Параметри повної локальної збірки ринку. Порожні значення використовують
# безпечні значення за замовчуванням зі збирача.
MARKET_HISTORY_DAYS=
MARKET_SNAPSHOT_END=
MARKET_PAGE_CONCURRENCY=
MARKET_DETAIL_CONCURRENCY=
MARKET_CLOSED_CAP=

# Параметри локальної збірки аналітики конкурентів.
COMPETITOR_HISTORY_DAYS=120
COMPETITOR_END=
COMPETITOR_PAGE_CONCURRENCY=
COMPETITOR_DETAIL_CONCURRENCY=
COMPETITOR_MAX_COMPANIES=

# Необов'язкові метадані для відтворюваних локальних snapshot-файлів.
INTERNAL_EXPORTED_AT=
INTERNAL_SOURCE_LABEL=
PROJECTS_EXPORTED_AT=
PROJECTS_SOURCE_LABEL=
